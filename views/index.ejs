<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Players</title>
</head>
<body>
    <h1>Players</h1>
    <ul>
        <% users.forEach(user => { %>
            <li><%= user.name %></li>
        <% }) %>
    </ul>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const socket = io(); 

      socket.on("connect", () => {
        console.log("Connected to server! Client ID:", socket.id);
        
        socket.emit("join_room", "gaming-lounge");
      });

=      socket.on("message", (data) => {
        console.log("Server says:", data);
        
        alert("Received from server: " + data);
      });
    </script>
</body>
</html>
